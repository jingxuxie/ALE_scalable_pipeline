{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2ale.local/schemas/task_blueprint.schema.json",
  "title": "paper2ale task blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "mode",
    "family",
    "summary",
    "evidence_ids",
    "workflow_nodes",
    "instances",
    "resource_budget",
    "output_contract",
    "evaluation",
    "tags"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/path_component_id"
    },
    "title": {
      "$ref": "#/$defs/nonempty_string"
    },
    "mode": {
      "enum": [
        "specification_preserving",
        "masked_workflow_completion",
        "method_masked_rediscovery"
      ]
    },
    "family": {
      "$ref": "#/$defs/nonempty_string"
    },
    "summary": {
      "$ref": "#/$defs/nonempty_string"
    },
    "evidence_ids": {
      "$ref": "#/$defs/nonempty_identifier_array"
    },
    "workflow_nodes": {
      "$ref": "#/$defs/nonempty_identifier_array"
    },
    "instances": {
      "type": "integer",
      "minimum": 1
    },
    "difficulty": {
      "$ref": "#/$defs/difficulty_selection"
    },
    "resource_budget": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "output_contract": {
      "type": "object"
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonempty_string"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "path_component_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$"
    },
    "nonempty_identifier_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonempty_string"
      },
      "uniqueItems": true
    },
    "difficulty_level": {
      "enum": ["easy", "medium", "hard", "frontier"]
    },
    "difficulty_generator_overrides": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "instance_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "input_complexity_scale": {"type": "number", "minimum": 0.25, "maximum": 4},
        "noise_scale": {"type": "number", "minimum": 0, "maximum": 3},
        "masked_fraction": {"type": "number", "minimum": 0, "maximum": 0.95},
        "constraint_count": {"type": "integer", "minimum": 0, "maximum": 128}
      }
    },
    "difficulty_evaluator_overrides": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "hidden_case_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "threshold_scale": {"type": "number", "minimum": 0.1, "maximum": 4},
        "rollout_horizon_scale": {"type": "number", "minimum": 0.25, "maximum": 8},
        "required_pass_fraction": {"type": "number", "minimum": 0.5, "maximum": 1},
        "adversarial_case_count": {"type": "integer", "minimum": 0, "maximum": 1024}
      }
    },
    "difficulty_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "level"],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "profile_version": {"type": "integer", "minimum": 1},
        "level": {"$ref": "#/$defs/difficulty_level"},
        "generator_overrides": {"$ref": "#/$defs/difficulty_generator_overrides"},
        "evaluator_overrides": {"$ref": "#/$defs/difficulty_evaluator_overrides"}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weight"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "direction": {
          "$ref": "#/$defs/nonempty_string"
        },
        "threshold": {
          "type": "number"
        },
        "description": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "gate": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonempty_string"
        },
        {
          "type": "object",
          "minProperties": 1
        }
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gates"],
      "anyOf": [
        {
          "required": ["weights"]
        },
        {
          "required": ["metrics"]
        }
      ],
      "properties": {
        "weights": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gate"
          }
        },
        "grader": {
          "$ref": "#/$defs/nonempty_string"
        },
        "description": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    }
  }
}
