{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2ale.local/schemas/project.schema.json",
  "title": "paper2ale project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_bundle",
    "evidence_graph",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "paper2ale.project/v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$"
    },
    "source_bundle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_ref"
      }
    },
    "evidence_graph": {
      "$ref": "evidence_graph.schema.json"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "task_blueprint.schema.json"
      }
    },
    "difficulty_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/difficulty_profile"
      }
    },
    "defaults": {
      "type": "object"
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "uri",
        "version",
        "license",
        "visibility"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "difficulty_level_name": {
      "enum": ["easy", "medium", "hard", "frontier"]
    },
    "difficulty_generator": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "required": ["instance_count"],
      "properties": {
        "instance_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "input_complexity_scale": {"type": "number", "minimum": 0.25, "maximum": 4},
        "noise_scale": {"type": "number", "minimum": 0, "maximum": 3},
        "masked_fraction": {"type": "number", "minimum": 0, "maximum": 0.95},
        "constraint_count": {"type": "integer", "minimum": 0, "maximum": 128}
      }
    },
    "difficulty_evaluator": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "hidden_case_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "threshold_scale": {"type": "number", "minimum": 0.1, "maximum": 4},
        "rollout_horizon_scale": {"type": "number", "minimum": 0.25, "maximum": 8},
        "required_pass_fraction": {"type": "number", "minimum": 0.5, "maximum": 1},
        "adversarial_case_count": {"type": "integer", "minimum": 0, "maximum": 1024}
      }
    },
    "difficulty_target_band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "lower", "upper", "confidence", "min_trials"],
      "properties": {
        "metric": {"const": "pass_rate"},
        "lower": {"type": "number", "minimum": 0, "maximum": 1},
        "upper": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "min_trials": {"type": "integer", "minimum": 1}
      }
    },
    "difficulty_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "version", "levels"],
      "properties": {
        "schema_version": {"const": "paper2ale.difficulty/v1"},
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "version": {"type": "integer", "minimum": 1},
        "description": {"type": "string"},
        "levels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "generator", "evaluator", "target_band"],
            "properties": {
              "name": {"$ref": "#/$defs/difficulty_level_name"},
              "generator": {"$ref": "#/$defs/difficulty_generator"},
              "evaluator": {"$ref": "#/$defs/difficulty_evaluator"},
              "target_band": {"$ref": "#/$defs/difficulty_target_band"}
            }
          }
        }
      }
    }
  }
}
