{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2ale.local/schemas/difficulty_profile.schema.json",
  "title": "paper2ale difficulty profile",
  "oneOf": [
    {"$ref": "#/$defs/profile_v1"},
    {"$ref": "#/$defs/profile_v2"}
  ],
  "$defs": {
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "level_name": {
      "enum": ["easy", "medium", "hard", "frontier"]
    },
    "target_band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "lower", "upper", "confidence", "min_trials"],
      "properties": {
        "metric": {"const": "pass_rate"},
        "lower": {"type": "number", "minimum": 0, "maximum": 1},
        "upper": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "min_trials": {"type": "integer", "minimum": 1}
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "input_complexity_scale": {"type": "number", "minimum": 0.25, "maximum": 4},
        "noise_scale": {"type": "number", "minimum": 0, "maximum": 3},
        "masked_fraction": {"type": "number", "minimum": 0, "maximum": 0.95},
        "constraint_count": {"type": "integer", "minimum": 0, "maximum": 128}
      }
    },
    "evaluation_power": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "hidden_case_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "threshold_scale": {"type": "number", "minimum": 0.1, "maximum": 4},
        "rollout_horizon_scale": {"type": "number", "minimum": 0.25, "maximum": 8},
        "required_pass_fraction": {"type": "number", "minimum": 0.5, "maximum": 1},
        "adversarial_case_count": {"type": "integer", "minimum": 0, "maximum": 1024}
      }
    },
    "benchmark_sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_count"],
      "properties": {
        "instance_count": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "generator_v1": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "required": ["instance_count"],
      "properties": {
        "instance_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "input_complexity_scale": {"type": "number", "minimum": 0.25, "maximum": 4},
        "noise_scale": {"type": "number", "minimum": 0, "maximum": 3},
        "masked_fraction": {"type": "number", "minimum": 0, "maximum": 0.95},
        "constraint_count": {"type": "integer", "minimum": 0, "maximum": 128}
      }
    },
    "generator": {"$ref": "#/$defs/generator_v1"},
    "evaluator": {"$ref": "#/$defs/evaluation_power"},
    "level_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "generator", "evaluator", "target_band"],
      "properties": {
        "name": {"$ref": "#/$defs/level_name"},
        "generator": {"$ref": "#/$defs/generator_v1"},
        "evaluator": {"$ref": "#/$defs/evaluation_power"},
        "target_band": {"$ref": "#/$defs/target_band"}
      }
    },
    "level_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "challenge",
        "evaluation_power",
        "benchmark_sampling",
        "target_band"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/level_name"},
        "challenge": {"$ref": "#/$defs/challenge"},
        "evaluation_power": {"$ref": "#/$defs/evaluation_power"},
        "benchmark_sampling": {"$ref": "#/$defs/benchmark_sampling"},
        "target_band": {"$ref": "#/$defs/target_band"}
      }
    },
    "level": {"$ref": "#/$defs/level_v1"},
    "profile_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "version", "levels"],
      "properties": {
        "schema_version": {"const": "paper2ale.difficulty/v1"},
        "id": {"$ref": "#/$defs/profile_id"},
        "version": {"type": "integer", "minimum": 1},
        "description": {"type": "string"},
        "levels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/level_v1"}
        }
      }
    },
    "profile_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "version", "levels"],
      "properties": {
        "schema_version": {"const": "paper2ale.difficulty/v2"},
        "id": {"$ref": "#/$defs/profile_id"},
        "version": {"type": "integer", "minimum": 2},
        "description": {"type": "string"},
        "levels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/level_v2"}
        }
      }
    },
    "generator_overrides": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "instance_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "input_complexity_scale": {"type": "number", "minimum": 0.25, "maximum": 4},
        "noise_scale": {"type": "number", "minimum": 0, "maximum": 3},
        "masked_fraction": {"type": "number", "minimum": 0, "maximum": 0.95},
        "constraint_count": {"type": "integer", "minimum": 0, "maximum": 128}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "level"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/profile_id"},
        "profile_version": {"type": "integer", "minimum": 1},
        "level": {"$ref": "#/$defs/level_name"},
        "generator_overrides": {"$ref": "#/$defs/generator_overrides"},
        "evaluator_overrides": {"$ref": "#/$defs/evaluation_power"}
      }
    },
    "selection_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "level"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/profile_id"},
        "profile_version": {"type": "integer", "minimum": 2},
        "level": {"$ref": "#/$defs/level_name"},
        "challenge_overrides": {"$ref": "#/$defs/challenge"},
        "evaluation_power_overrides": {"$ref": "#/$defs/evaluation_power"},
        "benchmark_sampling_overrides": {"$ref": "#/$defs/benchmark_sampling"},
        "calibrated_semantic_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
