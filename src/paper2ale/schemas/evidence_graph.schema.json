{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2ale.local/schemas/evidence_graph.schema.json",
  "title": "paper2ale evidence graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["records", "nodes", "edges", "claims"],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_record"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "identifier_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "impact": {
      "enum": ["low", "medium", "high"]
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "statement",
        "source_refs",
        "confidence",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "$ref": "#/$defs/identifier"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "$ref": "#/$defs/identifier_array",
          "minItems": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "$ref": "#/$defs/identifier"
        },
        "conflict_set": {
          "$ref": "#/$defs/identifier"
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "$ref": "#/$defs/impact"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "$ref": "#/$defs/identifier_array"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "kind"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "$ref": "#/$defs/identifier"
        },
        "evidence_ids": {
          "$ref": "#/$defs/identifier_array"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "evidence_ids"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "$ref": "#/$defs/identifier_array",
          "minItems": 1
        },
        "status": {
          "$ref": "#/$defs/identifier"
        },
        "impact": {
          "$ref": "#/$defs/impact"
        },
        "conflict_set": {
          "$ref": "#/$defs/identifier"
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
