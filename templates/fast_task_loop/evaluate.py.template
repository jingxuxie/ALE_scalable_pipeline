#!/usr/bin/env python3
"""Small task-specific evaluator for the fast task loop."""

from __future__ import annotations

import argparse
import json
import math
from pathlib import Path
from typing import Any


def close(actual: float, expected: float, *, atol: float, rtol: float) -> bool:
    return math.isfinite(actual) and abs(actual - expected) <= atol + rtol * abs(expected)


def evaluate(submission: Path) -> dict[str, Any]:
    """Return a small result: passed, score in [0,1], and reason.

    Replace this body with task-specific checks. Keep it quick. Prefer final
    behavior on one or a few hidden cases over source-code or byte comparison.
    """
    required = submission / "<required-output-file>"
    if not required.is_file():
        return {"passed": False, "score": 0.0, "reason": f"missing {required.name}"}

    # Example:
    # result = json.loads(required.read_text(encoding="utf-8"))
    # actual = float(result["metric"])
    # expected = float(json.loads((Path(__file__).parent / "hidden/reference.json").read_text())["metric"])
    # passed = close(actual, expected, atol=1e-6, rtol=1e-4)
    # return {"passed": passed, "score": 1.0 if passed else 0.0, "reason": "ok" if passed else "metric mismatch"}

    raise NotImplementedError("replace evaluate() with the task-specific check")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--submission", type=Path, required=True)
    args = parser.parse_args()

    try:
        result = evaluate(args.submission.resolve())
        score = float(result.get("score", 0.0))
        result["score"] = max(0.0, min(1.0, score))
        result["passed"] = bool(result.get("passed", False))
        result["reason"] = str(result.get("reason", ""))
    except Exception as exc:  # Fast screening should fail closed, not crash silently.
        result = {"passed": False, "score": 0.0, "reason": f"evaluator error: {exc}"}

    print(json.dumps(result, sort_keys=True))
    return 0 if result["passed"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
